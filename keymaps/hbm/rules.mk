# Enable HBM userspace code.

USER_NAME       = hbm
HBM_CORE_ENABLE = yes

# Key preferences.

HBM_BASE_LAYER_BSPC_ENABLE = yes
HBM_EXTRA_KEYS_ENABLE      = yes
HBM_US_SYMBOLS_ENABLE      = no

# Implementations of QMK features.

HBM_AUTO_SHIFT_ENABLE = yes
HBM_CAPS_WORD_ENABLE  = yes
HBM_COMBO_ENABLE      = no

# Custom features.

HBM_CUSTOM_KEYS_ENABLE  = yes
HBM_DEFER_SHIFT_ENABLE  = yes
HBM_DYNAMIC_MODS_ENABLE = no
HBM_HANDED_MODS_ENABLE  = yes
HBM_LAYER_COMBOS_ENABLE = no
